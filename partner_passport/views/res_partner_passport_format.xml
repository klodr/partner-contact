<odoo>
    <record id="res_partner_passport_format_view_list" model="ir.ui.view">
        <field name="name">res.partner.passport.format.list</field>
        <field name="model">res.partner.passport.format</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="country_id" />
                <field name="pattern" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="res_partner_passport_format_action" model="ir.actions.act_window">
        <field name="name">Passport Formats</field>
        <field name="res_model">res.partner.passport.format</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a passport number format per country
            </p>
            <p>
                The format (a regular expression) is used to validate the passport
                number entered on a contact, based on its nationality.
            </p>
        </field>
    </record>

    <menuitem
        id="res_partner_passport_format_menu"
        name="Passport Formats"
        parent="contacts.res_partner_menu_config"
        action="res_partner_passport_format_action"
        sequence="50"
    />
</odoo>

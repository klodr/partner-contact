<odoo noupdate="1">
    <record id="passport_format_at" model="res.partner.passport.format">
        <field name="country_id" ref="base.at" />
        <field name="pattern">[A-Z][0-9]{7}</field>
        <field name="name">1 letter + 7 digits</field>
    </record>
